<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".ui.delegation.SmsDelegationFragment">

        <TextView
            android:id="@+id/tv_sms_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delegate Care Plan 📱"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="#6366F1"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sms_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Send feeding schedules, care tasks, medications, &amp; routines to a pet sitter or contact via SMS."
            android:textColor="#64748B"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sms_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_recipient_phone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Recipient Phone Number 📞"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sms_subtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_recipient_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:text="+447700900077" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Live SMS Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sms_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_recipient_phone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Care Plan SMS Preview ✉️"
                    android:textColor="#6366F1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sms_preview_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    tools:text="PetCare — Max's Care Plan..." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons: Send SMS & General Share -->
        <LinearLayout
            android:id="@+id/layout_sms_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_sms_preview">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_sms_intent"
                style="@style/Widget.PetCare.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#6366F1"
                android:text="Send via SMS 📱"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_general"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Share Plan 📤"
                android:textColor="#6366F1"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#EEF2FF"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
