<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".ui.medical.AddEditMedicalFragment">

        <TextView
            android:id="@+id/tv_medical_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_medical"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="#6366F1"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Select Pet -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_select_pet"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Select Pet 🐾"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_medical_form_title">

            <AutoCompleteTextView
                android:id="@+id/actv_select_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Record Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_medical_title"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Record Title (e.g. Vaccination)"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_select_pet">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_medical_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Record Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_medical_type"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Record Type (Vaccination, Vet Visit, Medication)"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_medical_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_medical_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date & Time Row -->
        <LinearLayout
            android:id="@+id/layout_date_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_medical_type">

            <!-- Record Date -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_medical_date"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Date 📅"
                app:boxStrokeColor="#6366F1"
                app:hintTextColor="#6366F1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_medical_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Record Time -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_medical_time"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Time ⏰"
                app:boxStrokeColor="#6366F1"
                app:hintTextColor="#6366F1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_medical_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Veterinarian / Vet Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_medical_vet"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Veterinarian Name (e.g. Dr. Smith)"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_date_time">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_medical_vet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Clinic Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_medical_clinic"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Clinic / Hospital Name"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_medical_vet">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_medical_clinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_medical_notes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Notes &amp; Dosage Instructions"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_medical_clinic">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_medical_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_medical"
            style="@style/Widget.PetCare.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#6366F1"
            android:text="@string/btn_save"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_medical_notes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
