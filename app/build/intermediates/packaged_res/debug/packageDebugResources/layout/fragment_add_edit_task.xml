<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".ui.tasks.AddEditTaskFragment">

        <TextView
            android:id="@+id/tv_task_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_task"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="#6366F1"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Select Pet Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_select_pet"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Select Pet 🐾"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_task_form_title">

            <AutoCompleteTextView
                android:id="@+id/actv_select_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Task Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_title"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/task_title"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_select_pet">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_category"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/task_category"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_task_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="Feeding" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Scheduled Time -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_time"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/task_time"
            app:boxStrokeColor="#6366F1"
            app:hintTextColor="#6366F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_task_category">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:text="08:00" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Reminder Toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_reminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/task_reminder_enable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_task_time" />

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_task"
            style="@style/Widget.PetCare.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#6366F1"
            android:text="@string/btn_save"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switch_reminder" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
