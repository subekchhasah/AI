<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <CheckBox
            android:id="@+id/cb_task_complete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:buttonTint="#6366F1"
            android:contentDescription="Mark task as complete" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_task_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max Breakfast"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Priority Badge -->
                <TextView
                    android:id="@+id/tv_task_priority_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#FEE2E2"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="HIGH"
                    android:textColor="#B91C1C"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Pet Tag Badge -->
            <TextView
                android:id="@+id/tv_task_pet_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_quick_pet_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="🐾 Pet: Max"
                android:textColor="#6366F1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_time_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="2026-09-30 • 08:00 AM • Feeding"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action Buttons: Delegate, Edit, Delete -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_task_delegate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delegate task via SMS"
                android:padding="6dp"
                android:src="@drawable/ic_delegate"
                app:tint="#6366F1" />

            <ImageButton
                android:id="@+id/btn_task_edit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit task"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                app:tint="#3B82F6" />

            <ImageButton
                android:id="@+id/btn_task_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete task"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
